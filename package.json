{
  "name": "fanwaner",
  "version": "1.0.0",
  "private": true,
  "description": "Broke? Put out a meal and let a stranger buy it for you. An open-source, zero-build meal jar on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node scripts/check-i18n.mjs",
    "db:local": "wrangler d1 migrations apply fanwaner --local",
    "db:remote": "wrangler d1 migrations apply fanwaner --remote",
    "font:download": "node scripts/download-font.mjs",
    "font:upload": "node scripts/upload-font.mjs"
  },
  "devDependencies": {
    "cf-workers-og": "^3.0.1",
    "react": "^19.3.0",
    "wrangler": "^4.131.1"
  }
}
