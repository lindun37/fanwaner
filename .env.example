# Fanwaner — environment variables
#
# Copy this file to `.dev.vars` for local development (wrangler dev reads it automatically).
# When deploying to Cloudflare, the secrets below MUST be set with `wrangler secret put`,
# never committed to a config file.
# Public values (TURNSTILE_SITE_KEY, DEFAULT_LOCALE, ...) live in the [vars] block of
# wrangler.toml — see that file for the full list.

# Cloudflare Turnstile keys (create a site at https://dash.cloudflare.com -> Turnstile)
# TURNSTILE_SECRET_KEY must be set with: wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=

# Server-side secret used to hash the per-IP daily rate limit (any random string)
# wrangler secret put SERVER_SECRET
SERVER_SECRET=

# Admin key for the Fanwaner dashboard (sent as a Bearer token)
# wrangler secret put ADMIN_KEY
ADMIN_KEY=

# ---- Message notifications (all optional; skip a channel and it simply stays off) ----
# Telegram bot token: create a bot with @BotFather and copy the token here
# (each bowl owner supplies their own chat_id in the UI)
# wrangler secret put TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=

# Foreign-language notifications (Discord / Slack / ntfy / Pushover / generic webhook) use no
# platform-level secret — the bowl owner pastes their own webhook URL or topic in the UI.
#
# Email notifications work the same way: no platform email credentials are required.
# The bowl owner fills in their own provider details under "Edit bowl -> Message alerts"
# (mail API endpoint + their own API key + sender address). The platform only calls the
# owner's endpoint on their behalf and consumes the owner's own quota.
#
# ntfy self-hosted instances: point NTFY_API at your own server in wrangler.toml [vars]
# (default "https://ntfy.sh" uses the public service).
