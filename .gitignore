# 依赖与构建产物
node_modules/
.wrangler/
dist/

# 本地密钥（复制 .env.example 为 .dev.vars 后填写）
.dev.vars

# OG 字体（16MB，跑 scripts/download-font.mjs 现下，不提交）
fonts/

# Trae 本地文档（.trae/ 里的方案文档不进仓库）
.trae/

# 系统文件
.DS_Store
Thumbs.db

# 日志
*.log

# 临时测试脚本（.tmp-*.mjs 一类的本地调试残留）
.tmp-*.mjs

# 线上配置（由 scripts/gen-prod-config.mjs 在 CI 里现生成，含真实 D1 ID，不进仓库）
wrangler.prod.toml
